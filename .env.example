# Copy to .env. Every value is optional — with none of them set the site runs
# in demo mode, where checkout is simulated locally and nothing is charged.

# Port for the local server (default 3000)
PORT=3000

# ---------------------------------------------------------------- payments
# Add a secret key to switch checkout from demo mode to real Stripe Checkout.
# Test keys start with sk_test_ and charge nothing.
# STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx

# Webhook signing secret from `stripe listen` or the Stripe dashboard. Required
# in production: memberships are activated by the webhook, not by the browser
# landing on the success page.
#   stripe listen --forward-to localhost:3000/api/webhooks/stripe
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx
